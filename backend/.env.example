# Plantilla de variables de entorno. No la llenes a mano: genera un .env con secretos aleatorios con
#   python scripts/generar_env.py
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS=0
DJANGO_HSTS_SEGUNDOS=0
DJANGO_CSRF_ORIGENES=
DJANGO_ADMIN_URL=panel-admin/
CLAVE_CIFRADO_CAMPOS=
DB_MOTOR=sqlite
# Ruta opcional de la base de datos SQLite (útil para sacarla de OneDrive)
SQLITE_RUTA=
