# Plantilla de variables de entorno. No la llenes a mano: genera un .env con secretos aleatorios con
#   python scripts/generar_env.py                  (SQLite)
#   python scripts/generar_env.py --motor mysql    (MySQL; también crea mysql_crear_bd.sql)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS=0
DJANGO_HSTS_SEGUNDOS=0
DJANGO_CSRF_ORIGENES=
DJANGO_ADMIN_URL=panel-admin/
CLAVE_CIFRADO_CAMPOS=
# Base de datos: sqlite, mysql o postgres
DB_MOTOR=mysql
DB_NOMBRE=hackatecNacional
DB_USUARIO=hackatecNacional
DB_PASSWORD=
DB_HOST=localhost
DB_PUERTO=3306
# Ruta opcional de la base de datos SQLite (útil para sacarla de OneDrive)
SQLITE_RUTA=
